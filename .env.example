# ==============================================================================
# VARIABLES D'ENVIRONNEMENT (MODÈLE TYPE) - LEVELUP ("THE SYSTEM")
# Spécification: docs/08-IMPLEMENTATION_PLAN.md Section 22 & docs/05-SECURITY.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONNEMENT & RÉSEAU
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
WS_PORT=4001
LEVELUP_API_BASE_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 2. INFRASTRUCTURE POSTGRESQL 16 & PRISMA
# ------------------------------------------------------------------------------
POSTGRES_USER=levelup_master
POSTGRES_PASSWORD=levelup_secure_password_2026
POSTGRES_DB=levelup_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://levelup_master:levelup_secure_password_2026@localhost:5432/levelup_db?schema=public"

# ------------------------------------------------------------------------------
# 3. CLUSTER DE CACHE REDIS 7 (DISTRIBUTED LOCKS & RATE LIMITING)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIE SOUVERAINE & CONTRÔLE D'ACCÈS ZERO-TRUST
# ------------------------------------------------------------------------------
# Clé maîtresse AES-256-GCM (64 caractères hexadécimaux / 256 bits)
APP_MASTER_ENCRYPTION_KEY="VOTRE_CLE_HEX_256_BITS_64_CARACTERES"
APP_ENCRYPTION_KEY="VOTRE_CLE_HEX_256_BITS_64_CARACTERES"
JWT_SECRET="votre_secret_jwt_ultra_securise"
JWT_PRIVATE_KEY_PATH="./secrets/jwt_rsa_private.pem"
JWT_PUBLIC_KEY_PATH="./secrets/jwt_rsa_public.pem"
INTERNAL_SERVICE_JWT="votre_token_interne_service"

# ------------------------------------------------------------------------------
# 5. IDENTITÉ DU MONARQUE (SINGLE USER GUARD INVIOLABLE)
# ------------------------------------------------------------------------------
MASTER_USERNAME=Huriel
MASTER_USER_ID="a5d8b74f-9e32-4d2b-98f5-19e48f029a1b"
SYSTEM_MASTER_USER_ID="a5d8b74f-9e32-4d2b-98f5-19e48f029a1b"
DISCORD_MASTER_USER_ID="VOTRE_ID_UTILISATEUR_DISCORD"

# ------------------------------------------------------------------------------
# 6. BOT DISCORD MOBILE 24/7 (DISCORD.JS V14 GATEWAY)
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN="VOTRE_TOKEN_BOT_DISCORD"
DISCORD_CLIENT_ID="VOTRE_APPLICATION_ID_DISCORD"
DISCORD_GUILD_ID="VOTRE_SERVEUR_ID_DISCORD"

# ------------------------------------------------------------------------------
# 7. SENTINELLE CLOUD NEXTDNS (ZONE DE PÉNALITÉ & MONK MODE)
# ------------------------------------------------------------------------------
NEXTDNS_PROFILE_ID="votre_id_profil_nextdns"
NEXTDNS_API_KEY="votre_cle_api_nextdns"
PENALTY_HOSTS_PATH="C:\\Windows\\System32\\drivers\\etc\\hosts"

# ------------------------------------------------------------------------------
# 8. SERVICES IA LOCAUX & VEILLE OPPORTUNITÉS
# ------------------------------------------------------------------------------
WHISPER_INFERENCE_URL="http://127.0.0.1:5000/transcribe"
WHISPER_MODEL="large-v3-turbo"
DEERFLOW_WEBHOOK_SECRET="votre_secret_webhook_deerflow"
VAULT_ROOT_PATH="C:\\Users\\ADMIN\\Documents\\ObsidianVault"
